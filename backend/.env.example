# Server Configuration
NODE_ENV=development
PORT=5000

# Security (Required in production)
JWT_SECRET=replace_this_with_a_secure_random_secret_in_production

# Database (Default: backend/medilink.db, :memory: allowed for tests)
DB_PATH=medilink.db

# CORS Configuration (Comma-separated allowed origins, permissive in development)
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# Seed Configuration (In production, demo data is only seeded if SEED_DEMO=true)
SEED_DEMO=false

# Default Admin credentials (used on first boot in production if no admin exists)
ADMIN_EMAIL=admin@medilink.com
ADMIN_PASSWORD=adminpassword123
