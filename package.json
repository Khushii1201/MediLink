{
  "name": "medilink",
  "version": "1.0.0",
  "private": true,
  "description": "MediLink - Full-Stack Healthcare Coordination Platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm --prefix backend install && npm --prefix frontend install && npm --prefix frontend run build",
    "start": "node backend/server.js",
    "seed": "npm --prefix backend run seed",
    "reset": "node backend/reset.js",
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "test": "npm --prefix backend test",
    "lint": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
